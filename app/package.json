{
  "name": "keyisland-app",
  "private": true,
  "version": "0.1.9",
  "type": "module",
  "description": "密岛 KeyIsland —— Windows 单机私人账密管理工具（Phase 0/1 工程骨架与 Vault 核心）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "verify": "npm run typecheck && npm run test:run",
    "e2e:smoke": "node scripts/e2e/smoke.mjs",
    "e2e:startup-failure": "node scripts/e2e/smoke.mjs --startup-failure",
    "e2e:shell": "node scripts/e2e/shell.mjs",
    "desktop:doctor": "node scripts/desktop/doctor.mjs",
    "desktop:probe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop/window-probe.ps1",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "release:publish": "node scripts/desktop/publish-release.mjs",
    "desktop:verify": "npm run verify && node scripts/e2e/smoke.mjs --startup-failure",
    "tauri": "tauri",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "framer-motion": "^11.15.0",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
